# Base URL of the HR Policy Assistant backend (contracts/openapi-hr-policies-assistant.json).
# NEXT_PUBLIC_* vars ship in the client bundle — the browser calls this API
# directly, so never put secrets here. Real per-environment values live in
# .env.development / .env.production; use .env.local to override locally.
NEXT_PUBLIC_HR_ASSISTANT_API_URL=http://localhost:8000
